<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches examples/flutter/android/app/src/debug/AndroidManifest.xml.
         The demo backend serves plain HTTP, and from targetSdk 28 up cleartext
         is blocked unless opted into — without this the captcha images silently
         fail to load on a real device. Debug only; release keeps the default. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:usesCleartextTraffic="true" />
</manifest>
