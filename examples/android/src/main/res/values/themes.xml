         (?attr/textAppearanceTitleMedium) resolve to nothing and the tab titles
         render at a fraction of their intended size. -->
    <style name="Theme.CaptchaSample" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#667EEA</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#667EEA</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
    </style>
</resources>
