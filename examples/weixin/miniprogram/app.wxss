page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.section {
  margin-bottom: 40rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.btn {
  background: #1677ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
}

.btn:active {
  opacity: 0.8;
}

/* Dark mode - manual .cp-dark class toggle (global, shared by all pages) */
.container.cp-dark {
  min-height: 100vh;
  background: #1a1a1a;
}

.container.cp-dark .title {
  color: #fff;
}

.container.cp-dark .section {
  background: #2a2a2a;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  color: #eeeeee;
}

.container.cp-dark .section-title {
  color: #eeeeee;
}

.container.cp-dark .desc {
  color: #aaaaaa;
}
