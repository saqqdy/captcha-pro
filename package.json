{
  "name": "@captcha-pro/monorepo",
  "description": "A lightweight behavioral captcha library with slider puzzle and click verification - Monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "build": "turbo build",
    "build:core": "pnpm --filter @captcha-pro/core build",
    "build:vue3": "pnpm --filter @captcha-pro/vue3 build",
    "build:vue2": "pnpm --filter @captcha-pro/vue2 build",
    "build:react": "pnpm --filter @captcha-pro/react build",
    "build:mp-shared": "pnpm --filter @captcha-pro/mp-shared build",
    "build:taro-react": "pnpm --filter @captcha-pro/taro-react build",
    "build:taro-vue": "pnpm --filter @captcha-pro/taro-vue build",
    "build:taro-vue2": "pnpm --filter @captcha-pro/taro-vue2 build",
    "build:uniapp-vue": "pnpm --filter @captcha-pro/uniapp-vue build",
    "build:uniapp-vue2": "pnpm --filter @captcha-pro/uniapp-vue2 build",
    "build:weixin": "pnpm --filter @captcha-pro/weixin build",
    "build:server": "pnpm --filter captcha-pro-server-demo build",
    "dev": "pnpm --filter @captcha-pro/core watch",
    "dev:core": "pnpm --filter @captcha-pro/core watch",
    "dev:vue3": "pnpm --filter @captcha-pro/vue3 watch",
    "dev:vue2": "pnpm --filter @captcha-pro/vue2 watch",
    "dev:react": "pnpm --filter @captcha-pro/react watch",
    "dev:mp-shared": "pnpm --filter @captcha-pro/mp-shared watch",
    "dev:taro-react": "pnpm --filter @captcha-pro/taro-react watch",
    "dev:taro-vue": "pnpm --filter @captcha-pro/taro-vue watch",
    "dev:taro-vue2": "pnpm --filter @captcha-pro/taro-vue2 watch",
    "dev:uniapp-vue": "pnpm --filter @captcha-pro/uniapp-vue watch",
    "dev:uniapp-vue2": "pnpm --filter @captcha-pro/uniapp-vue2 watch",
    "dev:weixin": "pnpm --filter @captcha-pro/weixin watch",
    "dev:server": "pnpm --filter captcha-pro-server-demo dev",
    "start:server": "pnpm --filter captcha-pro-server-demo start",
    "play:react": "pnpm --filter example-react dev",
    "play:vue3": "pnpm --filter example-vue3 dev",
    "play:vue2": "pnpm --filter example-vue2 dev",
    "play:taro-react": "pnpm --filter example-taro-react dev:weapp",
    "play:taro-vue": "pnpm --filter example-taro-vue dev:weapp",
    "play:taro-vue2": "pnpm --filter example-taro-vue2 dev:weapp",
    "play:uniapp-vue": "pnpm --filter example-uniapp-vue dev:mp-weixin",
    "play:weixin": "pnpm --filter example-weixin dev",
    "test": "turbo test",
    "lint": "eslint --fix .",
    "prettier": "prettier --write \"**/*.{js,ts,jsx,tsx,vue,yml,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "pub": "pnpm -r publish --access public",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.0",
    "@eslint-sets/eslint-config": "^6.5.1",
    "@tarojs/binding-darwin-x64": "4.2.0",
    "@types/node": "^24.12.0",
    "eslint": "^9.22.0",
    "prettier": "^3.8.1",
    "prettier-config-common": "^1.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.21.5"
    }
  },
  "keywords": [
    "captcha",
    "behavioral-captcha",
    "slider-captcha",
    "puzzle-captcha",
    "click-captcha",
    "monorepo"
  ],
  "license": "MIT",
  "author": "saqqdy<https://github.com/saqqdy>",
  "homepage": "https://github.com/saqqdy/captcha-pro#readme",
  "bugs": {
    "url": "https://github.com/saqqdy/captcha-pro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saqqdy/captcha-pro.git"
  }
}
